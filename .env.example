# 授權與 API 集中檔（範本，不含任何機密，可以進 git）。
# 用法：複製成 .env.local，只在 .env.local 填值。.env.local 與 secrets\ 已被 .gitignore 排除。
# 載入（PowerShell，在 repo 根目錄）：  . .\research\load_env.ps1
# 載入後只存在於目前這個 PowerShell 視窗；關掉視窗就消失。空白的項目不會被設定。

# ---- 0. 環境設定（不是機密，建議保持 1）----
# 讓凍結環境看不到 C:\Users\GAI\AppData\Roaming\Python 的使用者套件，
# 否則 verify_environment.py 會因多出的套件而失敗，pip 也可能動到那邊的套件。
PYTHONNOUSERSITE=1
# 讓 Python 一律用 UTF-8（中文版 Windows 預設 cp950，會讀不了 git 輸出而讓部分測試失敗）。
PYTHONUTF8=1

# ---- 1. MOSEK 授權（建牆的力學分析必要，目前未取得）----
# mosek.lic 的路徑；建議放在 secrets\ 資料夾，例如 secrets\mosek.lic（相對路徑以 repo 根目錄為準）。
MOSEKLM_LICENSE_FILE=

# ---- 2. OpenAI（GPT 牆與 API 煙霧測試；付費）----
OPENAI_API_KEY=
# 付費閘門：要真的送出付費請求時才設成 1，平常留空。仍需在指令加 --confirm-paid。
STONEPACKING_ALLOW_PAID_API=

# ---- 3. Anthropic（選用；付費）----
ANTHROPIC_API_KEY=

# ---- 4. 只給本機模擬伺服器測試用（--loopback）----
# 付費執行時必須留空，否則 gpt_wall.py 會拒絕。
OPENAI_BASE_URL=
